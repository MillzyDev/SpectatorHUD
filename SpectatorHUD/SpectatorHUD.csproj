<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <LangVersion>14</LangVersion>
    </PropertyGroup>
    
    <PropertyGroup>
        <ModName>$(RootNamespace)</ModName>
        <ModAuthor>Millzy</ModAuthor>
        <ModVersion>1.0.1</ModVersion>
        <ModDescription>Create and load custom HUDs for the spectator camera.</ModDescription>
        <ModWebsite>https://github.com/MillzyDev/SpectatorHUD</ModWebsite>
        
        <ModApplyMelonAttributes>true</ModApplyMelonAttributes>
        <ModUseMelonId>true</ModUseMelonId>
        
        <MelonGameName>BONELAB</MelonGameName>
        <MelonGameDeveloper>StressLevelZero</MelonGameDeveloper>
        <AndroidGamePackageName>com.StressLevelZero.BONELAB</AndroidGamePackageName>
    </PropertyGroup>

    <ItemGroup>
        <ModDependencies Include="LavaGang-MelonLoader-0.6.6" />
        <ModDependencies Include="bonelib-BoneLib-3.2.2" />
        <ModDependencies Include="WNP78-FieldInjector-2.1.1" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <CopyToModsFolder>true</CopyToModsFolder>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <CopyToModsFolder>true</CopyToModsFolder>
        <ThunderstorePackage>true</ThunderstorePackage>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Il2CppInterop.Common">
            <HintPath>$(GamePath)\MelonLoader\net6\Il2CppInterop.Common.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Il2CppInterop.Runtime">
            <HintPath>$(GamePath)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Il2Cppmscorlib">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Il2CppSLZ.Marrow">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\Il2CppSLZ.Marrow.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Il2CppSystem">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\Il2CppSystem.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Il2CppSystem.Core">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\Il2CppSystem.Core.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Il2CppUltEvents">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\Il2CppUltEvents.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\Unity.TextMeshPro.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="UnityEngine.AnimationModule">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.AnimationModule.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="UnityEngine.AssetBundleModule">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.AssetBundleModule.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(GamePath)\MelonLoader\net6\0Harmony.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="MelonLoader">
            <HintPath>$(GamePath)\MelonLoader\net6\MelonLoader.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="FieldInjector">
            <HintPath>$(GamePath)\Mods\FieldInjector.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="BoneLib">
            <HintPath>$(GamePath)\Mods\BoneLib.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Resources\Half-Life 2.hud" />
        <EmbeddedResource Include="Resources\Half-Life 2.hud" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Millzy.MelonModBuddy" Version="1.0.4" />
    </ItemGroup>

</Project>
